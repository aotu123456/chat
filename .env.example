# ===== DeepSeek 文本模型配置 =====
# 必填:https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 通义万相图像生成配置 =====
# 可选(不填则"生成场景图"功能不可用):
# 阿里云百炼平台 https://bailian.console.aliyun.com 获取,请勿使用 dashscope 的 key
DASHSCOPE_API_KEY=sk-xxxx

# ===== 可选:默认对话模型 =====
# DEFAULT_LLM_MODEL=deepseek-chat
